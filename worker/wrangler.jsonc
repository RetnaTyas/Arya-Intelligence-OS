{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arya-ai-gateway",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "ai": {
    "binding": "AI"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
